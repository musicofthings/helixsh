{
  "name": "helixsh-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Sandboxed desktop application for planning and running nf-core pipelines with Helixsh",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "install-electron --no",
    "desktop:dev": "electron .",
    "desktop:test": "node --test desktop/test/*.test.cjs",
    "desktop:pack:mac": "node scripts/package_desktop.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.0.4",
    "electron": "43.2.0"
  }
}
